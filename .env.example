# Copy to .env and fill in from the Supabase dashboard (Project Settings -> API).

# Safe to publish. Supabase now calls this the *publishable* key (sb_publishable_...);
# older projects call it the anon key. It ships inside the browser bundle by design; it is the
# RLS policies, not this key's secrecy, that keep one customer out of another's rows.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# NEVER commit. The *secret* key (sb_secret_...; older projects: service_role). Bypasses row-level security entirely. Used only by the seed script
# and the sync-payments Edge Function, both of which run on a server, never in a browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# The upstream API the Edge Function mirrors from.
FINTECH_API_URL=https://zerofayyz-fintech-api.onrender.com

# Shared secret the sync-payments Edge Function requires in the x-sync-secret header.
# Generate with: openssl rand -hex 24. Set on the function with `supabase secrets set`.
SYNC_SECRET=GENERATE-ME
